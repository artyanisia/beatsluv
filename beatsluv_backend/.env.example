DATABASE_URL=postgresql://postgres:your_password@localhost:5433/beatsluv_db
MOCK_AUDIO_URL=https://example.com/mock-track.mp3
MUSIC_GENERATION_PROVIDER=replicate
REPLICATE_API_TOKEN=your_replicate_token_here
REPLICATE_MUSICGEN_MODEL_VERSION=stereo-melody-large

# Use this if you need the app to run without an AI API key.
# MUSIC_GENERATION_PROVIDER=demo

# Optional: use only with a working Hugging Face Inference Endpoint.
# MUSIC_GENERATION_PROVIDER=huggingface
# HUGGINGFACE_API_TOKEN=your_huggingface_token_here
# HUGGINGFACE_MODEL_ID=facebook/musicgen-small
# HUGGINGFACE_ENDPOINT_URL=https://your-endpoint.endpoints.huggingface.cloud
